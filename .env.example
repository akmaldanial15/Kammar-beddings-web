# ==============================================================================
# KAMAAR BEDDINGS (TUNAS SINAR JAYA ENTERPRISE) - ENVIRONMENT TEMPLATE
# ==============================================================================
# SALIN FAIL INI KEPADA '.env' DAN MASUKKAN NILAI SEBENAR ANDA.
# AMARAN KESELAMATAN: JANGAN SEKALI-KALI COMMIT FAIL '.env' SEBENAR KE GITHUB!
# ==============================================================================

# 1. Aplikasi & Domain
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="KAMAAR Beddings"
NEXT_PUBLIC_STORE_CURRENCY=MYR
NEXT_PUBLIC_DEFAULT_LOCALE=ms

# 2. CHIP Payment Gateway (https://gate.chip-in.asia)
# Gerbang Pembayaran FPX Online Banking, Touch 'n Go eWallet & DuitNow QR
CHIP_BRAND_ID=your-chip-brand-id-here
CHIP_SECRET_KEY=your-chip-secret-key-here
CHIP_PUBLIC_KEY=your-chip-public-key-here

# 3. Supabase Credentials (Pilihan - Digunakan jika sambung ke cloud Postgres)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 4. Transaksional Email (Resend)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="KAMAAR Beddings <pesanan@kamaar.my>"

# 5. Saluran Khidmat Pelanggan & Sokongan Kilang
NEXT_PUBLIC_WHATSAPP_NUMBER="+60194786991"
NEXT_PUBLIC_SUPPORT_EMAIL="kamaarbeddings@gmail.com"
NEXT_PUBLIC_SUPPORT_PHONE="+60194786991"

# 6. Admin Secret Key (Untuk pengesahan / setup keselamatan awal)
ADMIN_BOOTSTRAP_SECRET="kamaar_admin_secret_key_change_in_production"
